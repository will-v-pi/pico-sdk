        "//src/rp2_common/pico_flash",
        "//src/rp2_common/pico_multicore",
        "//test/pico_test",
    ] + select({
        "//bazel/constraint:host": ["//src/host/pico_stdlib"],
        "//conditions:default": ["//src/rp2_common/pico_stdlib"],
    }),
